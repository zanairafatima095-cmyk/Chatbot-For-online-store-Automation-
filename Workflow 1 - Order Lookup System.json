      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\"Greeting\", \"Product Information\", \"Business Hours\", \"Order Status\", \"Delivery Delay\", \"Refund Request\", \"Complaint\", \"Payment Issue\", \"Cancel Order\", \"Talk to Human\"]\n    },\n    \"response\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\"intent\", \"response\"]\n}"
      },
      "id": "5372e7b8-84b9-40a6-98fc-4e4d113c9135",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
